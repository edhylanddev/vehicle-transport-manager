# Copy to .env and fill in. NEVER commit .env.
APP_ENV=production

# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# MySQL (create a NEW user + password — the old ones in the archived code are compromised)
DATABASE_URL=mysql+pymysql://vtm:CHANGE_ME@localhost/vtm?charset=utf8mb4

APP_NAME=Vehicle Transport Manager
APP_URL=https://vehicletransport.autos
APP_TIMEZONE=America/New_York

# Where photos/signatures/receipts are stored (back this folder up!)
UPLOAD_FOLDER=/var/lib/vtm/uploads
MAX_UPLOAD_MB=60

# Set to 0 only when testing over plain http://localhost
COOKIE_SECURE=1

# Android app: put the APK in app/static/downloads/ and bump these when you publish a new one
ANDROID_APK_FILE=vtm.apk
ANDROID_VERSION_CODE=1
ANDROID_VERSION_NAME=1.0.0

# Anyone can create a company account at /signup. Set to 0 to close sign-ups.
ALLOW_SIGNUP=1
# Your email(s) — these logins can see /admin, the list of every company that signed up
SUPERADMIN_EMAILS=edhylanddev@gmail.com
