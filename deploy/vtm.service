# /etc/systemd/system/vtm.service
[Unit]
Description=Vehicle Transport Manager (Flask/gunicorn)
After=network.target mysql.service

[Service]
User=vtm
Group=vtm
WorkingDirectory=/opt/vtm
EnvironmentFile=/opt/vtm/.env
Environment=TZ=America/New_York
ExecStart=/opt/vtm/.venv/bin/gunicorn -w 3 -b 127.0.0.1:5055 --timeout 120 --access-logfile - wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
