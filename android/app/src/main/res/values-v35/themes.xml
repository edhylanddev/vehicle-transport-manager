<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 forces edge-to-edge for targetSdk 35; opt out so the web page
         isn't drawn under the status/navigation bars. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand</item>
        <item name="android:colorAccent">#F2A900</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
